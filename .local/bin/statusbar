#!/bin/bash --
# statusbar - simple example for status bar output
# requires mpc iotifywait pacmd pactl system-colours jq ip sar findmnt

# ? I3SOCK=/run/user/1000/i3/ipc-socket.1273461

statusdir=${TMPDIR:-/tmp}/statusbar-$HOSTNAME-$LOGNAME-$UID
datadir=$statusdir/data

if [[ -d $statusdir ]]; then
    printf 'statusbar: %s: directory exists\n' "$statusdir" >&2
    exit 1
fi

# Only the final directory needs these permissions.
# shellcheck disable=SC2174
mkdir -pm0700 "$statusdir" "$datadir"

trap 'rm -rf -- "$statusdir"; kill 0' EXIT

# Use bash's builtin sleep if available to avoid unnecessary forks.
enable sleep

procname() {
    printf '%s' "$1" > /proc/self/comm
}

music() {
    procname "${FUNCNAME[0]}"

    mkfifo -- "$statusdir"/mpc.pipe
    mpc current -f '[[[%album% - ]%artist% - ]%title%]|[%file%]' > "$datadir"/mpc

    while :; do
        mpc idleloop player > "$statusdir"/mpc.pipe &

        while read -r _; do
            mpc current -f '[[[%album% - ]%artist% - ]%title%]|[%file%]' > "$datadir"/mpc
        done < "$statusdir"/mpc.pipe

        # XXX Should use a service manager to manage this condition.
        sleep 7
    done
}

clock() {
    procname "${FUNCNAME[0]}"
    local second day

    while :; do
        printf -v day '%(%d)T'

        case $day in
        [!1]1) printf '%(%A the %-est of %B %-l:%M %^p)T' ;;
        [!1]2) printf '%(%A the %-end of %B %-l:%M %^p)T' ;;
        [!1]3) printf '%(%A the %-erd of %B %-l:%M %^p)T' ;;
        *)     printf '%(%A the %-eth of %B %-l:%M %^p)T'
        esac > "$datadir"/clock

        printf -v second '%(%S)T'
        sleep "$((60 - 10#$second))"
    done
}

battery() {
    procname "${FUNCNAME[0]}"
    local status threshold=$2 syspath=/sys/class/power_supply/$1

    if [[ -e $syspath/status ]]; then
        while :; do
            read -rN 3 status < "$syspath"/status
            read -rN 3 capacity < "$syspath"/capacity

            capacity=${capacity%$'\n'}

            case $status in
            Dis)#charging
                printf 'D%d\n' "$capacity" > "$datadir"/battery
            ;;
            Cha)#arging
                if ((capacity < threshold)); then
                    printf 'C%d\n' "$capacity" > "$datadir"/battery
                else
                    : > "$datadir"/battery
                fi
            ;;
            Not)# Charging
                if ((capacity < threshold)); then
                    printf '%d\n' "$capacity" > "$datadir"/battery
                else
                    : > "$datadir"/battery
                fi
            ;;
            Unk)#nown
                if ((capacity < threshold)); then
                    printf '%d?\n' "$capacity" > "$datadir"/battery
                else
                    : > "$datadir"/battery
                fi
            esac

            sleep 10
        done
    fi
}

stats() {
    procname "${FUNCNAME[0]}"
    local blockdev iface

    blockdev=$(findmnt -T "$PWD" -no source)

    read -r iface addr < <(ip -j r | jq -r '.[]|select(.dst=="default" and .prefsrc)|"\(.dev) \(.prefsrc)"')

    mkfifo -- "$statusdir"/stats.pipe

    cat <<\! > "$statusdir"/sar.awk
BEGIN {
    datadir = ENVIRON["datadir"]
    iface = ENVIRON["iface"]
    addr = ENVIRON["addr"]
}

NF==12 && $2=="all" {
    dest = datadir "/cpu"
    printf "%d\n", 100 - $NF > dest
    close(dest)
}

NF==10 && $2==iface {
    dest = datadir "/net"
    printf "%s %d %d\n", addr, $5, $6 > dest
    close(dest)
}

NF==9 && $2~/[0-9]/ {
    dest = datadir "/disk"
    printf "%d\n", $2 / 1024 > dest
    close(dest)
}

NF==12 && $2~/[0-9]/ {
    dest = datadir "/mem"
    printf "%d\n", $5 > dest
    close(dest)
}

NF==5 && $2=="1" {
    dest = datadir "/cputemp"
    if($3 > 84)
        printf "%d\n", $3 > dest
    else
        printf "" > dest

    close(dest)
}
!

    # XXX There appears to be a memory leak in mawk(1). After several days it
    #     can increase from 380 bytes of PSS to 144M. Using gawk instead.
    sar --dec=0 -n DEV -m TEMP --iface="$iface" -F --fs="$blockdev" -r -u ALL 2 > "$statusdir"/stats.pipe &
    datadir=$datadir iface=$iface addr=$addr gawk -f "$statusdir"/sar.awk < "$statusdir"/stats.pipe
}

