volume() {
    procname "${FUNCNAME[0]}"
    local event type

    if ! pulseaudio --check; then
        printf 'statusbar: pulsemonitor: pulseaudio not running\n' >&2
        return 1
    fi

    pastat() {
        pactl -f json list "$1" | jq -r '
            .[] | select(.state == "RUNNING" and (.muted | not)).volume
                | [keys_unsorted[] as $k | .[$k].value_percent[:-1] | tonumber]
                | add / length'
    }

    # Initial values.
    pastat sinks > "$datadir"/vol
    pastat sources > "$datadir"/mic

    mkfifo -- "$statusdir"/pulsemonitor.pipe
    pactl subscribe > "$statusdir"/pulsemonitor.pipe &

    while read -r _ event _ type _; do
        if [[ $event = "'change'" ]]; then
            case $type in
            sink) pastat sinks > "$datadir"/vol ;;
            source) pastat sources > "$datadir"/mic
            esac
        fi
    done < "$statusdir"/pulsemonitor.pipe
}

eventloop() {
    procname "${FUNCNAME[0]}"
    local file colours grey red w i c s

    colours=$(system-colours)
    read -r grey < "$colours"/grey
    read -r red < "$colours"/red

    {
        printf '(./"\\u0000")|['

        i=0
        for w in mpc mic vol bat thm cpu mem hdd net clk; do
            if [[ $w = bat || $w = thm ]]; then
                c=$(jq -n --arg c "$red" '$c')
            else
                c=$(jq -n --arg c "$grey" '$c')
            fi

            printf '%s{"name":"%s","full_text":.[%d],"color":%s}' "$s" "$w" "$i" "$c"
            s=,

            i=$((i + 1))
        done

        printf '],","\n'
    } > "$statusdir"/i3-filter.jq

    mkfifo -- "$statusdir"/inotifywait.pipe "$statusdir"/eventloop.pipe

    inotifywait -qme close_write --format %f%0 --no-newline "$datadir" > "$statusdir"/inotifywait.pipe &
    jq -Rrc --unbuffered --stream -f "$statusdir"/i3-filter.jq < "$statusdir"/eventloop.pipe &

    {
        # i3bar input protocol requires this header block.
        # https://i3wm.org/docs/i3bar-protocol.html
        printf '{"version":1}['

        while read -rd '' file; do
            if read -r -- "${file?}" < "$datadir"/"$file"; then
                # All of these variables are synthesised from the above read.
                # shellcheck disable=SC2154
                printf '%s\0' "${mpc:+MPD:$mpc}" \
                              "${vol:+VOL:$vol}" \
                              "${mic:+MIC:$mic}" \
                              "${battery:+BAT:$battery}" \
                              "${cputemp:+THM:$cputemp}" \
                              "${cpu:+CPU:$cpu}" \
                              "${mem:+MEM:$mem}" \
                              "${disk:+HDD:$disk}" \
                              "${net:+NET:$net}" \
                              "${clock:+$clock}"
                printf '\n'
            fi
        done < "$statusdir"/inotifywait.pipe > "$statusdir"/eventloop.pipe
    }
}

eventloop &

# XXX Waiting for inotifywait to settle?
sleep 2

volume &
music &
battery BAT0 79 &
stats &
clock &

# If enabled click events would be read here.
# while read -r stdin; do
#     : "$stdin"
# done

wait
