#!/bin/sh --
# ftdetect - attempts to detect the fallback family used for a given glyph
# requires pango-view
# license AGPL-3.0-only

usage() { printf 'usage: ftdetect [-f font] glyph\n'; }

while getopts :f: arg; do
    case $arg in
    f) font=$OPTARG ;;
    *) usage >&2; exit 1
    esac
done

shift "$((OPTIND-1))"

if ! [ "$1" ]; then
    usage >&2
    exit 1
fi

FC_DEBUG=4 pango-view -qt "$1" --font "${font:-sans}" 2>&1 \
| awk '$1 == "fullname:" {m = $0}; END {print m}'
