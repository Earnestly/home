#!/bin/sh --
# web - start a prefered web browser
# requires xdg-user-dir jq

firefox-transient() {
    mkdir -m 0700 -- "$tmp"/profile "$tmp"/tmp

    cat <<! > "$tmp"/profile/user.js
# Use XDG_DOWNLOAD_DIR to determine the download.dir location instead of
# it being determined by the HOME environment.
user_pref("browser.download.folderList", 2);
user_pref("browser.download.dir", $(jq -rcn --arg dir "$(xdg-user-dir DOWNLOAD)" '$dir | @json'));
!
    set -- --no-remote --profile "$tmp"/profile ${private+--private-window} "$@"

    HOME=$tmp XDG_CONFIG_HOME=$tmp TMP=$tmp/tmp command firefox "$@"
}

chromium-transient() {
    mkdir -m 0700 -- "$tmp"/Default

    jq -n --arg default_directory "$(xdg-user-dir DOWNLOAD)" '{"download": {$default_directory}}' > "$tmp"/Default/Preferences

    set -- --user-data-dir="$tmp" ${private+--ephemeral} "$@"

    XDG_CONFIG_HOME=$tmp command chromium "$@"
}

qutebrowser() {
    rundir=$XDG_RUNTIME_DIR/qutebrowser
    log=$rundir/log.pipe

    mkdir -pm 0700 -- "$rundir"

    if [ -e "$log" ] && ! [ -p "$log" ]; then
        rm -f -- "$log"
    fi

    if ! [ -p "$log" ]; then
        mkfifo -- "$log"
    fi

    # nb. This was more useful when developing qmatrix.py and cookies.py as it
    #     allowed me to see what was being blocked and why.
    nice logger -et qutebrowser -p info < "$log" &
    exec 9>"$log"
    rm -f -- "$log"

    set -- --qt-flag enable-features=JXL --target=tab-bg-silent --no-err-windows ${debug+-dD log-cookies --logfilter network} "$@"

    # python -m cProfile -o qutebrowser.prof /usr/bin/qutebrowser "$@" >&9 2>&1
    exec qutebrowser "$@" >&9 2>&1
}

unset -v debug private transient

browser=qutebrowser

while getopts :dptb: opt; do
    case $opt in
    d) debug=1 ;;
    p) private=1 ;;
    t) transient=1 ;;
    b) browser=$OPTARG ;;
    *) printf 'usage: web [-dpt] [-b browser] [--] [args]...\n' >&2; exit 1
    esac
done

shift "$((OPTIND - 1))"

if [ "$transient" ]; then
    browser=$browser-transient

    cleanup() { rm -rf -- "$tmp"; }

    tmp=${TMPDIR:-/tmp}/web-$browser-$$

    trap cleanup EXIT

    for signal in HUP INT QUIT TERM; do
        # shellcheck disable=SC2064
        trap "cleanup; trap - $signal EXIT; kill -s $signal $$" "$signal"
    done

    mkdir -pm 0700 -- "$tmp"
fi

if hash -- "$browser" 2> /dev/null; then
    "$browser" "$@"
else
    printf 'web: error: \047%s\047: no such command\n' "$browser" >&2
fi
