#!/bin/sh --
# web - start a prefered web browser

qutebrowser() {
    rundir=$XDG_RUNTIME_DIR/qutebrowser
    log=$rundir/log.pipe

    # --qt-flag no-sandbox
    # --qt-flag disable-gpu
    # --qt-flag disable-gpu-compositing
    # --qt-flag disable-gpu-rasterization
    # --qt-flag enable-native-gpu-memory-buffers
    # --qt-flag enable-blink-features=feat,...
    # --qt-flag js-flags=--jitless
    # --qt-flag single-process|process-per-site

    set -- --qt-flag enable-features=JXL \
           --target=tab-bg-silent \
           --no-err-windows \
           ${debug+-dD log-cookies --logfilter network} "$@"

    # shellcheck disable=SC2174
    mkdir -pm0700 -- "$rundir"

    if [ -e "$log" ] && ! [ -p "$log" ]; then
        rm -f -- "$log"
    fi

    if ! [ -p "$log" ]; then
        mkfifo -- "$log"
    fi

    nice logger -et qutebrowser -p info < "$log" &
    exec 9>"$log"
    rm -f -- "$log"

    # exec python -m cProfile -o qutebrowser.prof /usr/bin/qutebrowser "$@" >&9 2>&1
    exec qutebrowser "$@" >&9 2>&1
}

unset -v debug
browser=qutebrowser

while getopts :db: opt; do
    case $opt in
    d) debug=1 ;;
    b) browser=$OPTARG
    esac
done

shift "$((OPTIND - 1))"

case $browser in
qutebrowser|firefox|chromium) ;;
*) exit 1
esac

"$browser" "$@"
