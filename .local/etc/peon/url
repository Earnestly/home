#!/bin/sh --
# peon/uri - for anything that is not a local file
# requires mpv web peon trurl streamlink

fmatch() { printf %s "$1" | grep -Eqf "$2"; }

if attr web; then
    case $1 in
    https://*|http://*)
        exec web -- "$1"
    ;;

    *)
        warn '%s: no matching web candidates\n' "$1"
    esac
fi

if attr video; then
    case $1 in
    https://x.n0g.xyz/*|https://xcancel.com/*|https://nitter.*)
        exec mpv --profile=doomscroll -- "$(trurl -s host=x.com -- "$1")"
    ;;

    https://www.twitch.tv/*|https://twitch.tv/*)
        case $1 in
        */videos)
            exec mpv --profile=doomscroll -- "$1"
        ;;

        *)
            # XXX Needed to handle twitch's split live/vod mix audio streams.
            #     ytdl-raw-options-append=--audio-multistream= does not help.
            exec streamlink -p mpv -a --profile=twitch -t '{author}: {title}' "$1" '<=1080p60,best'
        esac
    ;;

    *)
        exec mpv --profile=doomscroll -- "$1"
    esac
fi

case $1 in
file://*)
    # nb. Decodes a percent-encoded filepath and guards against trailing
    #     newline removal caused by process substitution.
    path=$(trurl -g {path}z -- "$1")
    exec peon "${path%z}"
;;

# Imgur blocked the YooKay due to the Online Safety Act, thankfully
# duckduckgo.com can be used to proxy access.
https://i.imgur.com/*)
    # nb. The url given to u= must not be encoded.
    exec peon "https://external-content.duckduckgo.com/iu/?u=$1"
;;

https://*|http://*)
    if fmatch "$1" "$cfgdir"/patterns-video-url; then
        PEONATTRS=$(addattr video) exec peon "$1"
    else
        exec web -- "$1"
    fi
;;

ytdl://*)
    exec mpv -- "$1"
;;

*)
    # XXX Injection.
    exec web -- "g $1"

    warn '%s: no matching candidates\n' "$1"
esac
